{
  "compilerOptions": {
    "target": "ESNext",
    "module": "NodeNext",
    "lib": [
      "ESNext"
    ],

    "types": [
      "node"
    ],
    "verbatimModuleSyntax": true,
    "erasableSyntaxOnly": true,
    "rewriteRelativeImportExtensions": true,

    "declaration": true,
    "emitDeclarationOnly": true,
    "composite": true,
    "incremental": true,

    "strict": true,
    "skipLibCheck": true,
  },
  "include": [
    "src",
    "dist/std-index.json",
    "__tests__",
    "output.d.ts"
  ],
  "exclude": [
    "src/web"
  ],
  "references": [
    {
      "path": "./tsconfig.web.json"
    }
  ]
}